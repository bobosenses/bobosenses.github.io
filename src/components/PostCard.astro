---
import { postUrl, formatDate, summary, type Post } from '../lib/posts';
import Icon from './Icon.astro';
interface Props { post: Post; index: number }
const { post, index } = Astro.props;
---
<article class="post-card">
  <a href={postUrl(post)} class="post-card-link">
    <div class:list={['post-art', index % 2 === 0 ? 'art-terminal' : 'art-graph']} aria-hidden="true">
      <div class="art-grid"></div>
      {index % 2 === 0 ? <div class="terminal-window">
        <div class="terminal-bar"><span></span><span></span><span></span><small>~/experiments</small></div>
        <div class="terminal-body"><span class="terminal-muted">$ python app.py</span><br/><span>vLLM <span class="terminal-muted">×</span> ChromaDB</span><br/><span class="terminal-muted">Model loaded. Ready to build.</span><br/><span class="terminal-cursor">▍</span></div>
      </div> : <svg class="graph-art" viewBox="0 0 320 180" fill="none"><g stroke="currentColor" stroke-opacity=".35"><path d="m160 90-90-40m90 40 90-40m-90 40 0 65m0-65L60 132m100-42 100 42M70 50 60 132m190-82 10 82M70 50h180"/></g><g fill="var(--bg)" stroke="currentColor"><circle cx="160" cy="90" r="25"/><circle cx="70" cy="50" r="16"/><circle cx="250" cy="50" r="16"/><circle cx="60" cy="132" r="12"/><circle cx="260" cy="132" r="12"/><circle cx="160" cy="155" r="10"/></g><g fill="currentColor" font-family="monospace" font-size="12" text-anchor="middle"><text x="160" y="94">Neo4j</text><text x="70" y="54">N</text><text x="250" y="54">R</text></g></svg>}
      <span class="art-number">FIELD NOTES / {String(index + 1).padStart(2, '0')}</span>
    </div>
    <div class="post-card-body">
      <p class="card-label">{post.data.categories[0] || '技术笔记'}<Icon name="arrow" size={16}/></p>
      <h3>{post.data.title}</h3>
      <p class="card-summary">{summary(post)}</p>
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </div>
  </a>
</article>
