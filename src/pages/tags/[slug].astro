---
import { getPosts, getTerms, termSlug } from '../../lib/posts';
import TermArchive from '../../components/TermArchive.astro';
export async function getStaticPaths() {
  return getTerms(await getPosts(), 'tags').map(([name]) => ({ params: { slug: termSlug(name) }, props: { name } }));
}
const { name } = Astro.props;
---
<TermArchive kind="tags" name={name}/>
